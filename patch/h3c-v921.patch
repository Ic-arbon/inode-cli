+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Author: Iru Cai <vimacs.hacks@gmail.com>
+
+#include <config.h>
+
+#include "openconnect-internal.h"
+
+#include <assert.h>
+#include <libxml/tree.h>
+#include <stdbool.h>
+
+#define H3C_FRAME_IPV4		1
+#define H3C_FRAME_KEEPALIVE	2
+#define H3C_KEEPALIVE_DEFAULT	30
+#define H3C_KEEPALIVE_MISS_LIMIT 3
+#define H3C_MAX_FRAME_LEN	16384
+
+/*
+ * Protocol state that survives reconnects and is owned by h3c.c.
+ * `vpninfo->proto_data` points here; released by h3c_free_state().
+ */
+struct h3c_state {
+	char *login_url;
+	char *logout_url;
+	char *checkonline_url;
+	char *challenge_url;
+	char *tunnel_gateway;
+
+	int keepalive_time;	/* KEEPALIVETIME header; 0 disables keepalive/DPD */
+	int keepalive_configured;
+	int restrict_mode;
+	time_t last_rx;
+	time_t last_tx;
+
+	/* NET_EXTEND parse buffer (reused per connection attempt) */
+	struct oc_vpn_option *parse_opts;
+	struct oc_ip_info parse_ip_info;
+	int parse_saw_address;
+
+	/* Outgoing partial-write state */
+	size_t tx_offset;
+
+	/* Keepalive frame partial-write state */
+	unsigned char hb_buf[4];
+	size_t hb_offset;
+	int hb_pending;
+};
+
+static struct h3c_state *h3c_get_state(struct openconnect_info *vpninfo)
+{
+	struct h3c_state *state = vpninfo->proto_data;
+
+	if (!state) {
+		state = calloc(1, sizeof(*state));
+		if (!state)
+			return NULL;
+		state->keepalive_time = H3C_KEEPALIVE_DEFAULT;
+		vpninfo->proto_data = state;
+	}
+	return state;
+}
+
+void h3c_free_state(struct openconnect_info *vpninfo)
+{
+	struct h3c_state *state = vpninfo->proto_data;
+
+	if (!state)
+		return;
+
+	free(state->login_url);
+	free(state->logout_url);
+	free(state->checkonline_url);
+	free(state->challenge_url);
+	free(state->tunnel_gateway);
+
+	free_split_routes(&state->parse_ip_info);
+	free_optlist(state->parse_opts);
+
+	free(state);
+	vpninfo->proto_data = NULL;
+}
+
+static void h3c_reset_parse_state(struct h3c_state *state)
+{
+	free_split_routes(&state->parse_ip_info);
+	free_optlist(state->parse_opts);
+	memset(&state->parse_ip_info, 0, sizeof(state->parse_ip_info));
+	state->parse_opts = NULL;
+	state->parse_saw_address = 0;
+	free(state->tunnel_gateway);
+	state->tunnel_gateway = NULL;
+}
+
+static int h3c_set_url(char **dst, const char *url)
+{
+	free(*dst);
+	*dst = NULL;
+
+	if (!url)
+		return 0;
+
+	/* Login URLs are stored without a leading slash because
+	 * do_https_request() prepends one. */
+	if (url[0] == '/')
+		url++;
+
+	*dst = strdup(url);
+	if (!*dst)
+		return -ENOMEM;
+	return 0;
+}
+
+static int h3c_request_user_auth(struct openconnect_info *vpninfo, char **username,
+				 char **password)
+{
+	int ret = 0;
+	struct oc_auth_form *form = calloc(1, sizeof(struct oc_auth_form));
+	if (!form) {
+		goto nomem;
+	}
+	form->auth_id = strdup("_login");
+	form->message = strdup("Enter user credentials:");
+
+	struct oc_form_opt *opt_user = calloc(1, sizeof(struct oc_form_opt));
+	if (!opt_user) {
+		goto nomem;
+	}
+	form->opts = opt_user;
+
+	opt_user->name = strdup("username");
+	if (!opt_user->name) {
+		goto nomem;
+	}
+	opt_user->label = strdup("Username: ");
+	if (!opt_user->label) {
+		goto nomem;
+	}
+	opt_user->type = OC_FORM_OPT_TEXT;
+	opt_user->next = NULL;
+
+	struct oc_form_opt *opt_pass = calloc(1, sizeof(struct oc_form_opt));
+	if (!opt_pass) {
+		goto nomem;
+	}
+	opt_user->next = opt_pass;
+
+	opt_pass->name = strdup("password");
+	if (!opt_pass->name) {
+		goto nomem;
+	}
+	opt_pass->label = strdup("Password: ");
+	if (!opt_pass->label) {
+		goto nomem;
+	}
+	opt_pass->type = OC_FORM_OPT_PASSWORD;
+	opt_pass->next = NULL;
+
+	ret = process_auth_form(vpninfo, form);
+	if (ret != 0) {
+		return ret;
+	}
+
+	*username = opt_user->_value;
+	*password = opt_pass->_value;
+	opt_user->_value = opt_pass->_value = NULL;
+
+out:
+	if (form) {
+		free_auth_form(form);
+	}
+	return ret;
+nomem:
+	ret = -ENOMEM;
+	goto out;
+}
+
+static int h3c_get_vpn_param_from_headers(struct openconnect_info *vpninfo, char *k, char *v)
+{
+	struct h3c_state *state = h3c_get_state(vpninfo);
+	const char *value;
+	int ret;
+
+	if (!state)
+		return -ENOMEM;
+
+	if (!strcmp(k, "IPADDRESS")) {
+		value = add_option_dup(&state->parse_opts, "ipaddr", v, -1);
+		if (!value)
+			return -ENOMEM;
+		state->parse_ip_info.addr = value;
+		state->parse_saw_address = 1;
+	} else if (!strcmp(k, "SUBNETMASK")) {
+		int masklen = atoi(v);
+		struct in_addr mask_addr;
+		char abuf[INET_ADDRSTRLEN];
+
+		if (masklen)
+			mask_addr.s_addr = htonl(0xffffffff << (32 - masklen));
+		else /* Shifting by 32 is invalid, so special-case it */
+			mask_addr.s_addr = 0;
+
+		inet_ntop(AF_INET, &mask_addr, abuf, sizeof(abuf));
+		value = add_option_dup(&state->parse_opts, "netmask", abuf, -1);
+		if (!value)
+			return -ENOMEM;
+		state->parse_ip_info.netmask = value;
+	} else if (!strcmp(k, "ROUTES")) {
+		/* ROUTES: ip/mask;ip/mask;...;ip/mask */
+		const char *vp = v;
+		while (*vp != 0) {
+			const char *scanpos = vp;
+			while (*scanpos != 0 && *scanpos != ';') {
+				++scanpos;
+			}
+			if (scanpos != vp) {
+				struct oc_split_include *route;
+				value = add_option_dup(&state->parse_opts,
+						       "split-include", vp,
+						       scanpos - vp);
+				if (!value)
+					return -ENOMEM;
+				route = malloc(sizeof(*route));
+				if (!route)
+					return -ENOMEM;
+				route->route = value;
+				route->next = state->parse_ip_info.split_includes;
+				state->parse_ip_info.split_includes = route;
+			}
+			vp = scanpos + 1;
+		}
+	} else if (!strcmp(k, "DNS")) {
+		/* DNS: ip;ip;ip */
+		const char *vp = v;
+		int n = 0;
+		while (*vp != 0 && n < 3) {
+			const char *scanpos = vp;
+			while (*scanpos != 0 && *scanpos != ';') {
+				++scanpos;
+			}
+			if (scanpos != vp) {
+				value = add_option_dup(&state->parse_opts, "DNS",
+						       vp, scanpos - vp);
+				if (!value)
+					return -ENOMEM;
+				state->parse_ip_info.dns[n++] = value;
+			}
+			vp = scanpos + 1;
+		}
+	} else if (!strcmp(k, "GATEWAY")) {
+		free(state->tunnel_gateway);
+		state->tunnel_gateway = strdup(v);
+		if (!state->tunnel_gateway)
+			return -ENOMEM;
+	} else if (!strcmp(k, "KEEPALIVETIME")) {
+		state->keepalive_configured = 1;
+		state->keepalive_time = atoi(v);
+	} else if (!strcmp(k, "RESTRICT")) {
+		state->restrict_mode = atoi(v);
+	} else {
+		/* Unknown header: preserve it for diagnostics. */
+		add_option_dup(&state->parse_opts, k, v, -1);
+	}
+
+	if (vpninfo->dump_http_traffic) {
+		char buf[1000];
+		strcpy(buf, k);
+		strcat(buf, ":");
+		strcat(buf, v);
+		dump_buf(vpninfo, '<', buf);
+	}
+
+	ret = 0;
+	return ret;
+}
+
+static int h3c_store_location_action_from_headers(struct openconnect_info *vpninfo, char *k,
+						  char *v)
+{
+	if (strcmp(k, "Location-Action") == 0) {
+		add_option_dup(&vpninfo->cstp_options, "Location-Action", v, -1);
+	}
+	return 0;
+}
+
+static void h3c_parse_domain_list(struct openconnect_info *vpninfo, const char *domain_list_str,
+				  char **gateway_info_str_ptr)
+{
+	xmlDocPtr xml_doc = xmlReadMemory(domain_list_str, strlen(domain_list_str), NULL, NULL,
+					  XML_PARSE_NOERROR);
+	assert(xml_doc);
+
+	/*Get the root element node */
+	xmlNode *root_element = xmlDocGetRootElement(xml_doc);
+
+	// now we only use the first domain
+	char *vpn_name = NULL, *vpn_url = NULL;
+
+	// print_element_names(root_element);
+	// <data> ... </data>
+	if (xmlnode_is_named(root_element, "data")) {
+		// find <domainlist> ... </domainlist>
+		for (xmlNode *dom_list_node = root_element->children; dom_list_node;
+		     dom_list_node = dom_list_node->next) {
+			if (xmlnode_is_named(dom_list_node, "domainlist")) {
+				// find <domain> ... </domain>
+				for (xmlNode *dom = dom_list_node->children; dom;
+				     dom = dom->next) {
+					if (xmlnode_is_named(dom, "domain")) {
+						for (xmlNode *dom_prop = dom->children;
+						     dom_prop; dom_prop = dom_prop->next) {
+							if (xmlnode_is_named(dom_prop,
+									     "name")) {
+								xmlnode_get_val(dom_prop,
+										"name",
+										&vpn_name);
+							}
+							if (xmlnode_is_named(dom_prop, "url")) {
+								xmlnode_get_val(dom_prop, "url",
+										&vpn_url);
+							}
+							if (vpn_name != NULL
+							    && vpn_url != NULL) {
+								goto get_domain_success;
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+
+get_domain_success:
+	assert(vpn_name != NULL && vpn_url != NULL);
+	if (vpn_url[0] == '/') {
+		vpninfo->urlpath = strdup(vpn_url + 1);
+	} else {
+		vpninfo->urlpath = strdup(vpn_url);
+	}
+	struct oc_text_buf *reqbuf = buf_alloc();
+	int ret = do_https_request(vpninfo, "GET", NULL, reqbuf, gateway_info_str_ptr, NULL,
+				   HTTP_BODY_ON_ERROR);
+	assert(ret >= 0);
+	buf_free(reqbuf);
+}
+
+static bool check_login_success(struct openconnect_info *vpninfo, const char *xmlstr)
+{
+	if (!xmlstr)
+		return false;
+
+	xmlDocPtr login_result_xml =
+		xmlReadMemory(xmlstr, strlen(xmlstr), NULL, NULL, XML_PARSE_NOERROR);
+	if (!login_result_xml)
+		return false;
+
+	xmlNode *login_result_root = xmlDocGetRootElement(login_result_xml);
+
+	/*
+	 * the login API return the following XML:
+	 * <data>
+	 *   <result>
+	 *     Success or Failed
+	 *   </result>
+	 *   <replyMessage> ... </replyMessage>
+	 *   <private> ... </private>
+	 * </data>
+	 */
+	char *result_string = NULL;
+	char *reply_message = NULL;
+	bool login_success;
+
+	if (xmlnode_is_named(login_result_root, "data")) {
+		for (xmlNode *res_node = login_result_root->children; res_node;
+		     res_node = res_node->next) {
+			xmlnode_get_val(res_node, "result", &result_string);
+			xmlnode_get_val(res_node, "replyMessage", &reply_message);
+		}
+	}
+	if (result_string && strstr(result_string, "Success")) {
+		login_success = true;
+	} else {
+		login_success = false;
+		if (reply_message) {
+			vpn_progress(vpninfo, PRG_ERR, _("Login error: %s\n"), reply_message);
+		}
+	}
+	if (result_string)
+		free(result_string);
+
+	if (reply_message)
+		free(reply_message);
+
+	xmlFreeDoc(login_result_xml);
+	return login_success;
+}
+
+int h3c_obtain_cookie(struct openconnect_info *vpninfo)
+{
+	struct h3c_state *state = h3c_get_state(vpninfo);
+	int ret;
+
+	if (!state)
+		return -ENOMEM;
+
+	ret = openconnect_open_https(vpninfo);
+	if (ret) {
+		return ret;
+	}
+
+	assert(vpninfo->ssl_write);
+
+	struct oc_text_buf *reqbuf = buf_alloc();
+
+	buf_append(reqbuf, "GET /svpn/index.cgi HTTP/1.1\r\n");
+	char *orig_ua = vpninfo->useragent;
+	// The H3C client uses this UA on the first access
+	vpninfo->useragent = (char *)"SSLVPN-Client/3.0";
+	http_common_headers(vpninfo, reqbuf);
+	vpninfo->useragent = orig_ua;
+	buf_append(reqbuf, "\r\n");
+
+	if (buf_error(reqbuf)) {
+		vpn_progress(vpninfo, PRG_ERR, _("Error creating H3C connection request\n"));
+		ret = buf_error(reqbuf);
+		goto obtain_cookie_out;
+	}
+	if (vpninfo->dump_http_traffic) {
+		dump_buf(vpninfo, '>', reqbuf->data);
+	}
+
+	ret = vpninfo->ssl_write(vpninfo, reqbuf->data, reqbuf->pos);
+	if (ret < 0) {
+		goto obtain_cookie_out;
+	}
+
+	struct oc_text_buf *resp_buf = buf_alloc();
+	assert(resp_buf);
+	if (buf_error(resp_buf)) {
+		ret = buf_free(resp_buf);
+		goto obtain_cookie_out;
+	}
+
+	ret = process_http_response(vpninfo, 1, h3c_store_location_action_from_headers,
+				    resp_buf);
+
+	bool has_domain_list = false;
+	for (struct oc_vpn_option *opt = vpninfo->cstp_options; opt != NULL; opt = opt->next) {
+		if (strcmp(opt->option, "Location-Action") == 0) {
+			if (strcmp(opt->value, "GetDomainList") == 0) {
+				has_domain_list = true;
+			}
+			break;
+		}
+	}
+
+	char *gateway_info_str = NULL;
+
+	if (has_domain_list) {
+		char *domain_list_str = NULL;
+		if (ret == 302) {
+			ret = handle_redirect(vpninfo);
+			if (ret == 0) {
+				buf_truncate(reqbuf);
+				ret = do_https_request(vpninfo, "GET", NULL, reqbuf,
+						       &domain_list_str, NULL, HTTP_REDIRECT);
+				if (ret > 0) {
+					assert(domain_list_str != NULL);
+					dump_buf(vpninfo, '<', domain_list_str);
+				}
+			}
+		}
+		assert(domain_list_str);
+		h3c_parse_domain_list(vpninfo, domain_list_str, &gateway_info_str);
+	} else {
+		if (ret == 302) {
+			ret = handle_redirect(vpninfo);
+			if (ret == 0) {
+				buf_truncate(reqbuf);
+				ret = do_https_request(vpninfo, "GET", NULL, reqbuf,
+						       &gateway_info_str, NULL, HTTP_REDIRECT);
+				assert(ret > 0);
+			}
+		}
+	}
+
+	assert(gateway_info_str != NULL);
+
+	char *login_url = NULL;
+	char *logout_url = NULL;
+	char *checkonline_url = NULL;
+	char *challenge_url = NULL;
+	xmlDocPtr gwinfo_xml = xmlReadMemory(gateway_info_str, strlen(gateway_info_str), NULL,
+					     NULL, XML_PARSE_NOERROR);
+	assert(gwinfo_xml);
+	xmlNode *gwinfo_root = xmlDocGetRootElement(gwinfo_xml);
+	assert(gwinfo_root);
+	// <data> ... </data>
+	if (xmlnode_is_named(gwinfo_root, "data")) {
+		// find <gatewayinfo> ... </gatewayinfo>
+		for (xmlNode *gw_node = gwinfo_root->children; gw_node;
+		     gw_node = gw_node->next) {
+			if (xmlnode_is_named(gw_node, "gatewayinfo")) {
+				// we ignore <auth> ... </auth>, just find <url> ... </url>
+				for (xmlNode *url_nodes = gw_node->children; url_nodes;
+				     url_nodes = url_nodes->next) {
+					if (xmlnode_is_named(url_nodes, "url")) {
+						for (xmlNode *method_url = url_nodes->children;
+						     method_url;
+						     method_url = method_url->next) {
+							xmlnode_get_val(method_url, "login",
+									&login_url);
+							xmlnode_get_val(method_url, "logout",
+									&logout_url);
+							xmlnode_get_val(method_url,
+									"checkonline",
+									&checkonline_url);
+							xmlnode_get_val(method_url, "challenge",
+									&challenge_url);
+						}
+						if (login_url != NULL && logout_url != NULL
+						    && checkonline_url != NULL
+						    && challenge_url != NULL) {
+							goto do_visit_login_url;
+						}
+					}
+				}
+			}
+		}
+	}
+
+do_visit_login_url:
+	if (login_url == NULL || logout_url == NULL || checkonline_url == NULL
+	    || challenge_url == NULL) {
+		return -EINVAL;
+	}
+
+	if (h3c_set_url(&state->login_url, login_url) ||
+	    h3c_set_url(&state->logout_url, logout_url) ||
+	    h3c_set_url(&state->checkonline_url, checkonline_url) ||
+	    h3c_set_url(&state->challenge_url, challenge_url)) {
+		ret = -ENOMEM;
+		goto obtain_cookie_out;
+	}
+
+	char *username = NULL, *password = NULL;
+	assert(h3c_request_user_auth(vpninfo, &username, &password) == 0);
+	assert(login_url != NULL && logout_url != NULL && checkonline_url != NULL
+	       && challenge_url != NULL);
+	if (login_url[0] == '/') {
+		vpninfo->urlpath = strdup(login_url + 1);
+	} else {
+		vpninfo->urlpath = strdup(login_url);
+	}
+	buf_truncate(reqbuf);
+	struct oc_text_buf *request_data = buf_alloc();
+	buf_append(request_data, "request=");
+	buf_append_urlencoded(request_data, "<data><username>");
+	buf_append_urlencoded(request_data, username);
+	buf_append_urlencoded(request_data, "</username><password>");
+	buf_append_urlencoded(request_data, password);
+	buf_append_urlencoded(request_data, "</password></data>\r\n");
+	char *login_resp = NULL;
+	ret = do_https_request(vpninfo, "POST", "application/x-www-form-urlencoded",
+			       request_data, &login_resp, NULL, HTTP_BODY_ON_ERROR);
+	if (ret >= 0 && login_resp != NULL) {
+		dump_buf(vpninfo, '<', login_resp);
+	}
+
+	bool login_success = check_login_success(vpninfo, login_resp);
+	if (!login_success) {
+		ret = -EPERM;
+		goto obtain_cookie_out;
+	}
+
+	for (struct oc_vpn_option *cookie = vpninfo->cookies; cookie; cookie = cookie->next) {
+		if (!strcmp(cookie->option, "svpnginfo")) {
+			free(vpninfo->cookie);
+			if (asprintf(&vpninfo->cookie, "svpnginfo=%s", cookie->value) < 0) {
+				ret = -ENOMEM;
+				goto obtain_cookie_out;
+			}
+			ret = 0;
+			goto obtain_cookie_out;
+		}
+	}
+
+	// if svpnginfo cookie is not found, make the login fail
+	ret = -EPERM;
+
+obtain_cookie_out:
+	return ret;
+}
+
+int h3c_connect(struct openconnect_info *vpninfo)
+{
+	struct h3c_state *state = h3c_get_state(vpninfo);
+	struct oc_text_buf *request_data;
+	char *handshake_resp = NULL;
+	int ret;
+
+	if (!state)
+		return -ENOMEM;
+
+	h3c_reset_parse_state(state);
+
+	/* Cookie was produced by h3c_obtain_cookie() and persists across
+	 * reconnects. Split it into the option list once if needed. */
+	if (!vpninfo->cookies) {
+		ret = internal_split_cookies(vpninfo, 1, "svpnginfo");
+		if (ret)
+			return ret;
+	}
+
+	ret = openconnect_open_https(vpninfo);
+	if (ret)
+		return ret;
+
+	request_data = buf_alloc();
+	if (!request_data)
+		return -ENOMEM;
+
+	free(vpninfo->urlpath);
+	vpninfo->urlpath = strdup("");
+	if (!vpninfo->urlpath) {
+		buf_free(request_data);
+		return -ENOMEM;
+	}
+
+	ret = do_https_request(vpninfo, "NET_EXTEND", NULL, request_data,
+			       &handshake_resp, h3c_get_vpn_param_from_headers,
+			       HTTP_BODY_ON_ERROR);
+	free(handshake_resp);
+	buf_free(request_data);
+
+	if (!state->parse_saw_address) {
+		vpn_progress(vpninfo, PRG_ERR,
+			     _("H3C NET_EXTEND did not provide an IP address\n"));
+		h3c_reset_parse_state(state);
+		return ret < 0 ? ret : -EINVAL;
+	}
+
+	if (!state->parse_ip_info.mtu)
+		state->parse_ip_info.mtu = 1400;
+
+	/* install_vpn_opts() takes ownership of parse_opts and frees the
+	 * previous cstp_options/ip_info, so URL options are kept separately
+	 * in h3c_state. */
+	ret = install_vpn_opts(vpninfo, state->parse_opts, &state->parse_ip_info);
+	if (ret) {
+		free_split_routes(&state->parse_ip_info);
+		free_optlist(state->parse_opts);
+		state->parse_opts = NULL;
+		memset(&state->parse_ip_info, 0, sizeof(state->parse_ip_info));
+		return ret;
+	}
+	state->parse_opts = NULL;
+	memset(&state->parse_ip_info, 0, sizeof(state->parse_ip_info));
+
+	/* Reset transport buffers. */
+	free_pkt(vpninfo, vpninfo->cstp_pkt);
+	vpninfo->cstp_pkt = NULL;
+	vpninfo->partial_rec_size = 0;
+	state->tx_offset = 0;
+	state->hb_offset = 0;
+	state->hb_pending = 0;
+	state->last_rx = state->last_tx = vpninfo->ssl_times.last_rx =
+		vpninfo->ssl_times.last_tx = time(NULL);
+
+	monitor_fd_new(vpninfo, ssl);
+	monitor_read_fd(vpninfo, ssl);
+	monitor_except_fd(vpninfo, ssl);
+
+	vpn_progress(vpninfo, PRG_INFO,
+		     _("H3C connected; keepalive %d seconds\n"),
+		     state->keepalive_time);
+	return 0;
+}
+
+int h3c_bye(struct openconnect_info *vpninfo, const char *reason)
+{
+	struct h3c_state *state = h3c_get_state(vpninfo);
+	char *logout_resp = NULL;
+	int ret;
+
+	openconnect_close_https(vpninfo, 0);
+
+	if (!state || !state->logout_url) {
+		vpn_progress(vpninfo, PRG_DEBUG,
+			     _("H3C logout URL unknown; skipping logout request\n"));
+		return -EINVAL;
+	}
+
+	ret = openconnect_open_https(vpninfo);
+	if (ret)
+		return ret;
+
+	free(vpninfo->urlpath);
+	vpninfo->urlpath = strdup(state->logout_url);
+	if (!vpninfo->urlpath)
+		return -ENOMEM;
+
+	ret = do_https_request(vpninfo, "GET", NULL, NULL, &logout_resp, NULL,
+			       HTTP_BODY_ON_ERROR);
+	free(logout_resp);
+	openconnect_close_https(vpninfo, 0);
+
+	if (ret < 0)
+		vpn_progress(vpninfo, PRG_ERR, _("H3C logout failed\n"));
+	else
+		vpn_progress(vpninfo, PRG_INFO, _("H3C logout successful\n"));
+	return ret;
+}
+
+static int h3c_write_data_frame(struct openconnect_info *vpninfo,
+				struct h3c_state *state, int *work_done)
+{
+	struct pkt *pkt = vpninfo->current_ssl_pkt;
+	size_t total = pkt->len + 4;
+	size_t off = state->tx_offset;
+	int ret;
+
+	unmonitor_write_fd(vpninfo, ssl);
+	ret = ssl_nonblock_write(vpninfo, 0,
+				 (unsigned char *)&pkt->h3c.type + off,
+				 total - off);
+	if (ret < 0) {
+		vpn_progress(vpninfo, PRG_ERR, _("H3C send packet failed\n"));
+		return ret;
+	}
+	if (ret > 0)
+		off += ret;
+	state->tx_offset = off;
+
+	if (off == total) {
+		vpninfo->ssl_times.last_tx = state->last_tx = time(NULL);
+		free_pkt(vpninfo, pkt);
+		vpninfo->current_ssl_pkt = NULL;
+		state->tx_offset = 0;
+		(*work_done)++;
+	}
+	return 0;
+}
+
+static int h3c_handle_outgoing(struct openconnect_info *vpninfo,
+			       struct h3c_state *state, int *work_done)
+{
+	int ret;
+
+	if (!vpninfo->current_ssl_pkt) {
+		struct pkt *pkt = dequeue_packet(&vpninfo->outgoing_queue);
+		if (!pkt)
+			return 0;
+
+		store_le16(&pkt->h3c.type, H3C_FRAME_IPV4);
+		store_be16(&pkt->h3c.len, pkt->len);
+		vpninfo->current_ssl_pkt = pkt;
+		state->tx_offset = 0;
+	}
+
+	ret = h3c_write_data_frame(vpninfo, state, work_done);
+	return ret;
+}
+
+static int h3c_parse_frames(struct openconnect_info *vpninfo,
+			    struct h3c_state *state, int *work_done)
+{
+	struct pkt *pkt = vpninfo->cstp_pkt;
+	unsigned char *buf = (unsigned char *)pkt->data;
+	size_t len = vpninfo->partial_rec_size;
+	size_t off = 0;
+	int ret = 0;
+
+	while (len - off >= 4) {
+		uint16_t plen = load_be16(buf + off + 2);
+
+		if (plen > H3C_MAX_FRAME_LEN) {
+			vpn_progress(vpninfo, PRG_ERR,
+				     _("H3C frame too large (%u bytes)\n"), plen);
+			ret = -EINVAL;
+			break;
+		}
+		if (len - off < (size_t)4 + plen)
+			break;
+
+		/* Server keepalive response: 02 02 00 00 */
+		if (buf[off] == 0x02 && buf[off + 1] == 0x02 && plen == 0) {
+			vpn_progress(vpninfo, PRG_DEBUG,
+				     _("H3C keepalive response received\n"));
+			off += 4;
+			(*work_done)++;
+			continue;
+		}
+
+		if (load_le16(buf + off) == H3C_FRAME_IPV4) {
+			struct pkt *out = alloc_pkt(vpninfo, plen);
+			if (!out) {
+				ret = -ENOMEM;
+				break;
+			}
+			memcpy(out->data, buf + off + 4, plen);
+			out->len = plen;
+			queue_packet(&vpninfo->incoming_queue, out);
+			off += 4 + plen;
+			(*work_done)++;
+			continue;
+		}
+
+		vpn_progress(vpninfo, PRG_ERR,
+			     _("H3C unknown frame type %02x %02x len %u; dropping\n"),
+			     buf[off], buf[off + 1], plen);
+		off += 4 + plen;
+	}
+
+	if (off) {
+		memmove(buf, buf + off, len - off);
+		vpninfo->partial_rec_size = len - off;
+	}
+	return ret;
+}
+
+static int h3c_start_keepalive(struct h3c_state *state)
+{
+	state->hb_buf[0] = 0x02;
+	state->hb_buf[1] = 0x00;
+	state->hb_buf[2] = 0x00;
+	state->hb_buf[3] = 0x00;
+	state->hb_offset = 0;
+	state->hb_pending = 1;
+	return 0;
+}
+
+static int h3c_write_keepalive(struct openconnect_info *vpninfo,
+			       struct h3c_state *state, int *work_done)
+{
+	size_t off = state->hb_offset;
+	int ret;
+
+	unmonitor_write_fd(vpninfo, ssl);
+	ret = ssl_nonblock_write(vpninfo, 0, state->hb_buf + off, 4 - off);
+	if (ret < 0)
+		return ret;
+	if (ret > 0)
+		off += ret;
+	state->hb_offset = off;
+
+	if (off == 4) {
+		vpninfo->ssl_times.last_tx = state->last_tx = time(NULL);
+		state->hb_pending = 0;
+		state->hb_offset = 0;
+		(*work_done)++;
+		vpn_progress(vpninfo, PRG_DEBUG, _("H3C keepalive sent\n"));
+	}
+	return 0;
+}
+
+int h3c_mainloop(struct openconnect_info *vpninfo, int *timeout, int readable)
+{
+	struct h3c_state *state = h3c_get_state(vpninfo);
+	int work_done = 0;
+	int ret;
+
+	if (!state)
+		return -ENOMEM;
+
+	if (vpninfo->ssl_fd == -1)
+		goto do_reconnect;
+
+	while (readable) {
+		/* Some servers send us packets that are larger than
+		   negotiated MTU. We reserve some extra space to
+		   handle that */
+		int receive_mtu = MAX(H3C_MAX_FRAME_LEN,
+				      vpninfo->deflate_pkt_size ?:
+				      vpninfo->ip_info.mtu);
+		int len;
+
+		if (!vpninfo->cstp_pkt) {
+			vpninfo->cstp_pkt = alloc_pkt(vpninfo, receive_mtu);
+			if (!vpninfo->cstp_pkt) {
+				vpn_progress(vpninfo, PRG_ERR,
+					     _("H3C allocation failed\n"));
+				break;
+			}
+			vpninfo->partial_rec_size = 0;
+		}
+
+		if (vpninfo->partial_rec_size >= receive_mtu) {
+			vpn_progress(vpninfo, PRG_ERR,
+				     _("H3C receive buffer overflow\n"));
+			goto do_reconnect;
+		}
+
+		len = ssl_nonblock_read(vpninfo, 0,
+					vpninfo->cstp_pkt->data +
+					vpninfo->partial_rec_size,
+					receive_mtu - vpninfo->partial_rec_size);
+		if (!len)
+			break;
+		if (len < 0) {
+			vpn_progress(vpninfo, PRG_ERR,
+				     _("H3C read error; reconnecting\n"));
+			goto do_reconnect;
+		}
+
+		vpninfo->partial_rec_size += len;
+		vpninfo->ssl_times.last_rx = state->last_rx = time(NULL);
+
+		ret = h3c_parse_frames(vpninfo, state, &work_done);
+		if (ret)
+			goto do_reconnect;
+	}
+
+	ret = h3c_handle_outgoing(vpninfo, state, &work_done);
+	if (ret)
+		goto do_reconnect;
+
+	/* Keepalive / Dead Peer Detection. KEEPALIVETIME=0 disables both. */
+	if (state->keepalive_time > 0) {
+		time_t now = time(NULL);
+		time_t next_hb = state->last_tx + state->keepalive_time;
+		time_t dpd_due = state->last_rx +
+				 state->keepalive_time *
+				 H3C_KEEPALIVE_MISS_LIMIT;
+
+		if (state->hb_pending) {
+			ret = h3c_write_keepalive(vpninfo, state, &work_done);
+			if (ret)
+				goto do_reconnect;
+		} else if (now >= next_hb) {
+			h3c_start_keepalive(state);
+			ret = h3c_write_keepalive(vpninfo, state, &work_done);
+			if (ret)
+				goto do_reconnect;
+		}
+
+		if (now >= dpd_due) {
+			vpn_progress(vpninfo, PRG_ERR,
+				     _("H3C Dead Peer Detection detected dead peer!\n"));
+			goto do_reconnect;
+		}
+
+		/* Ensure the event loop wakes for the next keepalive or
+		 * DPD deadline even if there is no other work. */
+		ka_check_deadline(timeout, now, next_hb);
+		ka_check_deadline(timeout, now, dpd_due);
+	}
+
+	return work_done;
+
+do_reconnect:
+	vpn_progress(vpninfo, PRG_INFO, _("H3C reconnecting...\n"));
+
+	free_pkt(vpninfo, vpninfo->current_ssl_pkt);
+	vpninfo->current_ssl_pkt = NULL;
+	state->tx_offset = 0;
+	state->hb_pending = 0;
+	state->hb_offset = 0;
+
+	ret = ssl_reconnect(vpninfo);
+	if (ret) {
+		vpn_progress(vpninfo, PRG_ERR, _("H3C reconnect failed\n"));
+		vpninfo->quit_reason = "H3C reconnect failed";
+		return ret;
+	}
+
+	return 1;
+}

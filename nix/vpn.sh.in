#!@bash@/bin/bash
set -euo pipefail

# LaunchAgent 环境 PATH 极简，补上系统目录以便找到 sudo/pkill/launchctl/route
export PATH="$PATH:/usr/bin:/bin:/usr/sbin:/sbin"

GATEWAY="${H3C_GATEWAY:-}"
VPN_DIR="$HOME/.vpn"
PID_FILE="$VPN_DIR/vpn-pid"
LOG_FILE="$VPN_DIR/vpn-log"
DIR_FILE="$VPN_DIR/vpn-dir"

mkdir -p "$VPN_DIR"
@watchLink@

# 安全兜底：symlink 断链或不存在时修复（不删已有有效 symlink，避免竞态）
if [ ! -L "$VPN_DIR/vpn" ] || [ ! -e "$VPN_DIR/vpn" ]; then
    rm -f "$VPN_DIR/vpn"
    SELF_DIR="$(cd "$(dirname "$0")" && pwd -P || echo "$PWD")"
    SELF_PATH="$SELF_DIR/$(basename "$0")"
    if [ "$SELF_PATH" != "$VPN_DIR/vpn" ]; then
        ln -sf "$SELF_PATH" "$VPN_DIR/vpn"
    fi
fi

# ===== 配置 =====

PING_TARGET="${VPN_PING_TARGET:-192.168.18.1}"   # 隧道内可达地址，判活用
NET_PROBE="${VPN_NET_PROBE:-223.5.5.5}"          # 公网可达探测（默认网关不可达时回退）
SUPERVISE_LOG="$VPN_DIR/watchdog-log"            # 守护/重连日志
RECONNECT_TIMEOUT="${VPN_RECONNECT_TIMEOUT:-120}"  # 单次 reconnect 退避重试总时长上限(s)
SUPERVISE_INTERVAL="${VPN_SUPERVISE_INTERVAL:-20}" # supervise 巡检间隔(s)
MAX_LOG_SIZE=104857600  # 100MB

# ===== 内部工具 =====

# 以 ping 判断隧道是否真正连通（真实 IP 层可达性），
# 避免"openconnect 进程还在但隧道已断/忙循环"的假阳性
is_vpn_alive() {
    ping -c 1 -t 2 "$PING_TARGET" >/dev/null 2>&1
}

# 判断本机网络是否就绪（已拿到 IP + 有可达的默认路由）。
# 唤醒后头几秒"醒着但没网"，此时拨号会 EADDRNOTAVAIL，故重连前先门控。
is_network_ready() {
    local gw
    gw=$(route -n get default 2>/dev/null | awk '/gateway:/{print $2}')
    if [ -n "$gw" ] && ping -c 1 -t 2 "$gw" >/dev/null 2>&1; then
        return 0
    fi
    ping -c 1 -t 2 "$NET_PROBE" >/dev/null 2>&1
}

# 日志护栏：超过 100MB 截断保留尾部
log_guard() {
    for f in "$LOG_FILE" "$SUPERVISE_LOG"; do
        [ -f "$f" ] || continue
        local sz
        sz=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)
        if [ "$sz" -gt "$MAX_LOG_SIZE" ]; then
            tail -n 2000 "$f" > "$f.tmp" && mv "$f.tmp" "$f"
        fi
    done
}

# 强制刷新 ~/.vpn/vpn 指向当前脚本真实路径。
# 重建 flake 后旧 store 路径会被 GC，launchd/hook 经 symlink 调用时需指向新路径。
# 仅当经由 store 路径调用（$0 != 该 symlink）时才重写，避免把 symlink 指向自身。
refresh_self_link() {
    local self_dir self_path
    self_dir="$(cd "$(dirname "$0")" && pwd -P 2>/dev/null || echo "$PWD")"
    self_path="$self_dir/$(basename "$0")"
    if [ "$self_path" != "$VPN_DIR/vpn" ]; then
        ln -sf "$self_path" "$VPN_DIR/vpn"
    fi
}

# 优雅停止 openconnect：先 SIGTERM，让其 vpnc-script 跑 teardown
# （自动删除"到网关"的主机路由并拆除 tun），等它退出；最多等 ~5s 仍在再 SIGKILL 兜底。
# 直接 -9 会跳过 teardown，遗留脏路由 → 盒盖换网/续 DHCP 后新连接 connect()
# 被内核按死路由送出 → Can't assign requested address (EADDRNOTAVAIL)，且重启系统前无法自愈。
graceful_kill_openconnect() {
    pgrep -f "[o]penconnect" >/dev/null 2>&1 || return 0
    sudo pkill -TERM -f "[o]penconnect" 2>/dev/null || true
    local i
    for i in $(seq 1 10); do
        pgrep -f "[o]penconnect" >/dev/null 2>&1 || return 0
        sleep 0.5
    done
    sudo pkill -9 -f "[o]penconnect" 2>/dev/null || true
}

# 兜底清理残留的"到 VPN 网关"主机路由：当上次是 -9 强杀或睡眠把进程卡死、
# teardown 没跑成时，会遗留一条指向旧网络下一跳的 STATIC 主机路由。换网/续 DHCP
# 后该下一跳不可达，源地址失效，导致新连接长期失败。启动前主动删一次即可解套。
clean_stale_gateway_route() {
    # GATEWAY 含 :port（如 140.206.103.26:2000，供 openconnect 用），但路由表以裸 IP
    # 为目的地；route delete -host 带端口会 "not in table" 静默失败。剥掉端口再删。
    local host="${GATEWAY%%:*}"
    [ -n "$host" ] || return 0
    sudo route delete -host "$host" >/dev/null 2>&1 || true
}

# 仿 systemd 用法：首个参数为子命令，其余参数透传
CMD="${1:-}"
if [ "$#" -gt 0 ]; then shift; fi

usage() {
    echo "用法: vpn <命令> [参数]" >&2
    echo "" >&2
    echo "  start             连接 VPN（在含 .auth 的目录中运行）" >&2
    echo "  stop              断开 VPN（并清除自动重连目标）" >&2
    echo "  restart           断开后在当前目录重新连接" >&2
    echo "  status            查看连接与守护服务状态" >&2
    echo "  enable [--now]    安装开盖唤醒/掉线自动重连服务（macOS）；--now 同时立即连接" >&2
    echo "  disable [--now]   移除自动重连服务；--now 同时立即断开" >&2
    echo "  install-sudoers   写入 openconnect 的 sudo 免密规则（macOS，一次性）" >&2
    echo "  uninstall-sudoers 移除 sudo 免密规则" >&2
}

# reconnect：回到上次成功启动的目录，等网络就绪后带退避重试连接，
# 直到连上或超过 RECONNECT_TIMEOUT。唤醒 hook 与 supervise 均调用此命令（内部）。
if [ "$CMD" = "reconnect" ]; then
    # 并发锁：sleepwatcher 唤醒与 supervise 巡检可能同时触发，避免双重重连互相 pkill
    LOCK="$VPN_DIR/reconnect.lock"
    if [ -d "$LOCK" ] && find "$LOCK" -maxdepth 0 -mmin +5 2>/dev/null | grep -q .; then
        rmdir "$LOCK" 2>/dev/null || true   # 清理超过 5 分钟的陈旧锁（持锁进程已崩）
    fi
    if ! mkdir "$LOCK" 2>/dev/null; then
        exit 0   # 已有重连在进行
    fi
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

    if [ ! -s "$DIR_FILE" ]; then
        echo "未找到上次 VPN 工作目录，请先在项目目录手动运行一次 vpn start" >&2
        exit 1
    fi
    TARGET=$(cat "$DIR_FILE")
    if [ ! -d "$TARGET" ]; then
        echo "记录的 VPN 目录已不存在: $TARGET" >&2
        exit 1
    fi
    cd "$TARGET"

    if is_vpn_alive; then exit 0; fi   # 已连通，无需动作

    deadline=$(( $(date +%s) + RECONNECT_TIMEOUT ))
    delay=3
    while [ "$(date +%s)" -lt "$deadline" ]; do
        # 用户可能在重连期间执行 stop（清除 DIR_FILE）→ 立即放弃，不与用户对抗
        if [ ! -s "$DIR_FILE" ]; then
            echo "[$(date)] 重连目标已被清除，停止重连" >> "$SUPERVISE_LOG"
            exit 0
        fi
        if is_network_ready; then
            if "$0" start >> "$SUPERVISE_LOG" 2>&1 && is_vpn_alive; then
                echo "[$(date)] reconnect 成功" >> "$SUPERVISE_LOG"
                exit 0
            fi
        else
            echo "[$(date)] 等待网络就绪..." >> "$SUPERVISE_LOG"
        fi
        sleep "$delay"
        delay=$(( delay * 2 ))
        if [ "$delay" -gt 60 ]; then delay=60; fi
    done
    echo "[$(date)] reconnect 超时放弃 (${RECONNECT_TIMEOUT}s)" >> "$SUPERVISE_LOG"
    exit 1
fi

# supervise：常驻守护（由 launchd 经 vpn-watch 拉起，脱离终端会话）。
# 周期巡检连通性，掉线即触发带退避的 reconnect。扛得过睡眠与终端关闭。
if [ "$CMD" = "supervise" ]; then
    while true; do
        if [ -s "$DIR_FILE" ] && ! is_vpn_alive; then
            "$0" reconnect >/dev/null 2>&1 || true
        fi
        log_guard
        sleep "$SUPERVISE_INTERVAL"
    done
fi

# enable：安装开盖唤醒/掉线自动重连服务（macOS）；--now 同时立即连接
if [ "$CMD" = "enable" ]; then
    if [ "$(uname)" != "Darwin" ]; then
        echo "enable 仅支持 macOS" >&2
        exit 1
    fi
    refresh_self_link   # 确保 launchd/hook 经 ~/.vpn/vpn 调到当前（新）路径
    PLIST="$HOME/Library/LaunchAgents/com.user.vpn-reconnect.plist"
    mkdir -p "$HOME/Library/LaunchAgents"
    {
        echo '<?xml version="1.0" encoding="UTF-8"?>'
        echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
        echo '<plist version="1.0"><dict>'
        echo '<key>Label</key><string>com.user.vpn-reconnect</string>'
        echo '<key>ProgramArguments</key>'
        echo "<array><string>$VPN_DIR/vpn-watch</string></array>"
        echo '<key>RunAtLoad</key><true/>'
        echo '<key>KeepAlive</key><true/>'
        echo '</dict></plist>'
    } > "$PLIST"
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST" 2>/dev/null || true
    echo "已安装唤醒/掉线自动重连守护服务"
    echo "提示：需先配置 openconnect 的 sudo 免密（vpn install-sudoers），否则重连会因等待 sudo 密码而失败"
    if [ "${1:-}" = "--now" ]; then
        exec "$0" start
    fi
    exit 0
fi

# disable：移除自动重连服务；--now 同时立即断开
if [ "$CMD" = "disable" ]; then
    PLIST="$HOME/Library/LaunchAgents/com.user.vpn-reconnect.plist"
    launchctl unload "$PLIST" 2>/dev/null || true
    rm -f "$PLIST"
    echo "已移除自动重连守护服务"
    if [ "${1:-}" = "--now" ]; then
        exec "$0" stop
    fi
    exit 0
fi

# status：查看连接、工作目录与守护服务状态（仿 systemctl status，
# 退出码：已连接 0 / 未连接 3）。以 ping 网关为真实连通性判断。
if [ "$CMD" = "status" ]; then
    RC=3
    if is_vpn_alive; then
        PID_INFO=""
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            PID_INFO=" (pid $(cat "$PID_FILE"))"
        fi
        echo "● vpn - 已连接 (active, running)$PID_INFO"
        RC=0
    else
        echo "○ vpn - 未连接 (inactive)"
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "  ⚠ 进程存活但 ping $PING_TARGET 不通 — 建议运行 vpn restart"
        fi
    fi
    if [ -s "$DIR_FILE" ]; then
        echo "  工作目录: $(cat "$DIR_FILE")"
    fi
    if [ "$(uname)" = "Darwin" ]; then
        PLIST="$HOME/Library/LaunchAgents/com.user.vpn-reconnect.plist"
        if [ -f "$PLIST" ]; then
            if launchctl list 2>/dev/null | grep -q com.user.vpn-reconnect; then
                echo "  守护/开盖重连: enabled (已加载)"
            else
                echo "  守护/开盖重连: enabled (未加载)"
            fi
        else
            echo "  守护/开盖重连: disabled"
        fi
    fi
    if [ -s "$SUPERVISE_LOG" ]; then
        echo "  最近重连日志:"
        tail -n 3 "$SUPERVISE_LOG" | sed 's/^/    /'
    fi
    exit "$RC"
fi

# install-sudoers：写入 openconnect / kill / pkill 的 sudo 免密规则，
# 使守护重连无需交互输入 sudo 密码（首次写入需一次 sudo 授权）
if [ "$CMD" = "install-sudoers" ]; then
    if [ "$(uname)" != "Darwin" ]; then
        echo "install-sudoers 目前仅适配 macOS 命令路径" >&2
        exit 1
    fi
    USER_NAME=$(id -un)
    TMP=$(mktemp)
    {
        echo "# openconnect-h3c VPN 免密规则，由 vpn install-sudoers 生成"
        # /sbin/route 免密是关键：clean_stale_gateway_route 需删残留网关主机路由，
        # 否则 launchd 无 tty / 手动时 prompt 被吞 → 删除静默失败 → 换网段后脏路由
        # 遗留、connect() 报 EADDRNOTAVAIL，且重启系统前无法自愈。
        echo "$USER_NAME ALL=(root) NOPASSWD: /nix/store/*/bin/openconnect, /bin/kill, /usr/bin/pkill, /sbin/route"
    } > "$TMP"
    if ! visudo -c -f "$TMP" >/dev/null; then
        echo "sudoers 语法校验失败，未写入" >&2
        rm -f "$TMP"
        exit 1
    fi
    echo "即将写入 /etc/sudoers.d/vpn（需要一次 sudo 授权）："
    sed 's/^/  /' "$TMP"
    sudo install -m 0440 -o root -g wheel "$TMP" /etc/sudoers.d/vpn
    rm -f "$TMP"
    echo "已安装 sudo 免密规则"
    exit 0
fi

if [ "$CMD" = "uninstall-sudoers" ]; then
    sudo rm -f /etc/sudoers.d/vpn
    echo "已移除 sudo 免密规则"
    exit 0
fi

AUTH_FILE="$PWD/.auth"
if [ -f "$AUTH_FILE" ]; then
    auth_val() { sed -n "s/^$1=//p" "$AUTH_FILE" | head -1; }
    USERNAME=$(auth_val username)
    PASSWORD=$(auth_val password)
    SERVERCERT=$(auth_val servercert)
    AUTH_GATEWAY=$(auth_val gateway)
    if [ -n "${AUTH_GATEWAY:-}" ]; then
        GATEWAY="$AUTH_GATEWAY"
    fi
fi

# stop：断开连接，并清除重连目标（DIR_FILE）作为"暂停"信号 —
# supervise 见无目标则空转，不会与用户对抗把连接拉回。
if [ "$CMD" = "stop" ]; then
    rm -f "$DIR_FILE"
    # [v] 技巧防止 pkill 匹配自身；杀掉正在进行的 start（含 reconnect 触发的）
    pkill -f "[v]pn.*start" 2>/dev/null || true
    # 优雅终止 openconnect，让它自行删除网关主机路由+拆 tun；卡死才 -9 兜底
    graceful_kill_openconnect
    # 兜底：万一 teardown 没跑成，主动清掉残留的网关主机路由
    clean_stale_gateway_route
    rm -f "$PID_FILE"
    echo "VPN 已停止"
    exit 0
fi

# restart：当前目录下断开后重连
if [ "$CMD" = "restart" ]; then
    "$0" stop || true
    exec "$0" start "$@"
fi

# 至此仅接受 start
if [ -z "$CMD" ]; then
    usage
    exit 0
fi
if [ "$CMD" != "start" ]; then
    echo "未知命令: $CMD" >&2
    usage
    exit 1
fi

# 启动前日志护栏（>100MB 截断，防重启后旧日志撑满磁盘）
log_guard

# 维护家目录下的稳定入口（绝对路径），仅在 start 时强制刷新
refresh_self_link

# [v] 技巧防止 pkill 匹配自身：清掉可能并行的旧 start
pkill -f "[v]pn.*start" 2>/dev/null || true

OPENCONNECT="@openconnect@/bin/openconnect"

if [ -f "$AUTH_FILE" ]; then
    # 缺少 servercert 时先探测网关证书指纹并写回 .auth。
    # 否则后台运行的 openconnect 会卡在交互式"是否信任证书 (yes/no)"
    # 提示上——stdin 只喂了密码，无人应答证书确认 → start 卡死。
    # 探测原理：喂 "no" 让 openconnect 在证书确认处主动 abort，
    # 此前它已把 "pin-sha256:..." 指纹打到输出，从中提取即可。
    if [ -z "${SERVERCERT:-}" ]; then
        echo "未配置 servercert，正在探测网关证书指纹..."
        DISCOVER_OUT=$(printf 'no\n' | "$OPENCONNECT" --protocol=h3c --no-dtls "$GATEWAY" 2>&1 || true)
        # 网关多为 pin-sha256:<base64>，也兼容旧式 sha256:<hex>
        SERVERCERT=$(printf '%s\n' "$DISCOVER_OUT" | grep -oE '(pin-)?sha256:[A-Za-z0-9+/=]+' | head -1)
        if [ -z "$SERVERCERT" ]; then
            echo "未能自动探测到证书指纹，请检查网关地址/网络连通性" >&2
            printf '%s\n' "$DISCOVER_OUT" | tail -n 10 >&2
            exit 1
        fi
        if grep -q '^servercert=' "$AUTH_FILE"; then
            TMP_AUTH=$(mktemp)
            sed "s|^servercert=.*|servercert=$SERVERCERT|" "$AUTH_FILE" > "$TMP_AUTH" && mv "$TMP_AUTH" "$AUTH_FILE"
        else
            printf 'servercert=%s\n' "$SERVERCERT" >> "$AUTH_FILE"
        fi
        echo "已获取并写入 servercert: $SERVERCERT"
    fi

    CERT_ARG=()
    if [ -n "${SERVERCERT:-}" ] && [ "${SERVERCERT:-}" != "" ]; then
        CERT_ARG=(--servercert "$SERVERCERT")
    fi

    # 先优雅停掉残留 openconnect（让其 teardown 删路由），卡死再 -9
    graceful_kill_openconnect
    # 兜底：清掉上一轮 -9/睡眠卡死遗留的网关主机路由，否则本次 connect()
    # 会被脏路由送往不可达的旧网关 → Can't assign requested address
    clean_stale_gateway_route
    rm -f "$PID_FILE"

    printf "%s\n" "$PASSWORD" | \
        sudo "$OPENCONNECT" --protocol=h3c --passwd-on-stdin --no-dtls "${CERT_ARG[@]}" "$GATEWAY" -u "$USERNAME" "$@" > "$LOG_FILE" 2>&1 &
    PID=$!
    echo "$PID" > "$PID_FILE"

    # 等待并 ping 验证隧道真正可用（最多等 ~13s）
    sleep 3
    CONNECTED=0
    for i in 1 2 3 4 5; do
        if is_vpn_alive; then
            CONNECTED=1
            break
        fi
        sleep 2
    done

    if [ "$CONNECTED" = "1" ]; then
        echo "$PWD" > "$DIR_FILE"
        echo "VPN 已连接 (pid $PID)"
    else
        echo "VPN 启动失败（进程存活但 ping $PING_TARGET 不通）"
        echo "最后几行日志："
        tail -n 5 "$LOG_FILE"
        if kill -0 "$PID" 2>/dev/null; then
            sudo kill -9 "$PID" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
        exit 1
    fi
else
    echo "未找到 .auth 文件，手动输入凭据"
    sudo "$OPENCONNECT" --protocol=h3c --no-dtls "$GATEWAY" "$@"
fi
